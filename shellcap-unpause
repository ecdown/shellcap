#!/usr/bin/env bash
state_dir="${SHELLCAP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/shellcap}"
mkdir -p "$state_dir/paused" 2>/dev/null || true

case "${1:-}" in
  --global|-g)
    rm -f "$state_dir/paused/global" 2>/dev/null || true
    echo "shellcap unpaused (global)"
    exit 0
    ;;
  --all|-a)
    rm -rf "$state_dir/paused" 2>/dev/null || true
    mkdir -p "$state_dir/paused" 2>/dev/null || true
    echo "shellcap unpaused (all sessions)"
    exit 0
    ;;
  --session|-s)
    sess="${2:-${SHELLCAP_SESSION_ID:-}}"
    if [ -z "$sess" ]; then
      echo "Error: no session ID specified (use --session ID or set SHELLCAP_SESSION_ID)" >&2
      exit 1
    fi
    rm -f "$state_dir/paused/$sess" 2>/dev/null || true
    echo "shellcap unpaused (session $sess)"
    exit 0
    ;;
  *)
    if [ -n "${SHELLCAP_SESSION_ID:-}" ]; then
      rm -f "$state_dir/paused/${SHELLCAP_SESSION_ID}" 2>/dev/null || true
    fi
    rm -f "$state_dir/paused/global" 2>/dev/null || true
    echo "shellcap unpaused"
    exit 0
    ;;
esac
